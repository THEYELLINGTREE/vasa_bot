# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Optional: Required Guild and Role Configuration
# If set, only users in this guild with these roles can access the web interface
# REQUIRED_GUILD_ID=your_discord_server_id_here
# ALLOWED_ROLE_IDS=role1_id,role2_id,role3_id

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here

# API Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_PATH=./data/vasa_bot.db

# Social Media APIs (for future use)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
